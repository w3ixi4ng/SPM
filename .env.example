# Copy to .env and fill in. Never commit .env.
#
#   cp .env.example .env         # the project you work against
#   cp .env.example .env.test    # a throwaway project, for tests and scans
#
# Integration tests and security scans create and delete real rows, so they run
# against .env.test:  docker compose --env-file .env.test up
#
# Every variable a service reads must appear here with an empty value (or a
# safe default). This file is the contract for what a new developer fills in.

# ---- Supabase ----------------------------------------------------------
# Values come from the dashboard: Settings -> API.

# Project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=

# service_role key. Backend only — it bypasses row-level security, so it must
# never be shipped to the frontend or committed anywhere.
SUPABASE_SERVICE_KEY=


# ---- Service ports -----------------------------------------------------
# Each service owns a distinct port so they can all run at once, in Docker or
# directly. These are the host ports docker compose publishes; they match the
# port baked into each service's Dockerfile.
USERS_SERVICE_PORT=8001
EVENTS_SERVICE_PORT=8002

# ---- Composite wiring --------------------------------------------------
# Base URLs composite services use to reach the atomic ones.
#
#   under docker compose : http://users:8001   (hostname = compose service name)
#   running directly     : http://localhost:8001
#
# The defaults below are the compose form, which is what `docker compose up`
# needs. Switch them to localhost when running services by hand.
USERS_SERVICE_URL=http://users:8001
EVENTS_SERVICE_URL=http://events:8002
