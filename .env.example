# Copy to .env and fill in. Never commit .env.
#
#   cp .env.example .env
#
# Values come from the Supabase dashboard: Settings -> API.

# ---- Supabase ----------------------------------------------------------
# Project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=

# service_role key. Backend only — it bypasses row-level security, so it must
# never be shipped to the frontend or committed anywhere.
SUPABASE_SERVICE_KEY=




