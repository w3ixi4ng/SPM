# Copy to .env and fill in. Never commit .env.
#
#   cp .env.example .env
#
# Vite only exposes variables prefixed with VITE_, and it inlines them into the
# built JavaScript. Anything here is public — put secrets in the root .env,
# which the backend services read.

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=

# anon (public) key — safe in the browser, subject to row-level security.
# Used for Supabase Auth. Never use the service_role key here.
VITE_SUPABASE_ANON_KEY=

