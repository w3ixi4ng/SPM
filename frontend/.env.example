# Copy to .env and fill in. Never commit .env.
#
#   cp .env.example .env
#
# Vite only exposes variables prefixed with VITE_, and it inlines them into the
# built JavaScript. Anything here is public — put secrets in the root .env,
# which the backend services read.

# Where the backend lives. In development this is a path, not a host: the Vite
# proxy forwards /api to Kong, keeping the browser on one origin so the session
# cookies work. In production it is Kong's own URL.
VITE_API_URL=/api

# Supabase, for the browser to talk to directly. NOT used for signing in --
# auth goes through the backend, which keeps the session in httpOnly cookies
# the page cannot read. Using these to log in as well would give you two
# competing sessions.

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=https://xbldxjjxkpteaztyeqxe.supabase.co/

# anon (public) key — safe in the browser, subject to row-level security.
# Used for Supabase Auth. Never use the service_role key here.
VITE_SUPABASE_ANON_KEY=sb_publishable_QM0oeVYO87DjJmU69dS_lw_y9EkoZsM

